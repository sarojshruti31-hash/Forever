# Forever - Environment Variables
# Copy this file to backend/.env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/forever

# Server port (default: 4000)
PORT=4000

# Cloudinary (for product image uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
CLOUDINARY_NAME=

# JWT secret key (use a long random string in production)
JWT_SECRET=forever_secret

# Stripe payment gateway
STRIPE_SECRET_KEY=

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin credentials
ADMIN_EMAIL=admin@forever.com
ADMIN_PASSWORD=admin_password
